# Скопируйте этот файл в .env и заполните

# 1. Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# 2. НЕОБЯЗАТЕЛЬНО: почта (отчёты и так приходят в Телеграм, если нажать /start в боте)
#    Почта для отчётов маме (пример для Gmail; пароль — «пароль приложения», не обычный)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ваша_почта@gmail.com
SMTP_PASSWORD=
MAIL_TO=ваша_почта@gmail.com

# 3. Необязательно
PARENT_TELEGRAM_ID=        # ваш Telegram ID (узнать: написать боту /myid) — отчёты придут и в Телеграм
TZ_NAME=Europe/Moscow    # ваш часовой пояс, например Europe/Madrid, Asia/Almaty
START_TIME=17:00           # во сколько присылать задания (потом можно командой /settime)
SESSION_MINUTES=10         # длительность ежедневной тренировки

# 4. Необязательно: «учитель на Claude» (кнопка «Объясни по-другому» и команда /ask).
#    Это платный API Anthropic (оплата за использование), подписка claude.ai его не включает.
#    Ключ создаётся на console.anthropic.com. Без ключа бот работает полностью.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5   # самая экономичная модель
CLAUDE_MONTHLY_LIMIT=100        # максимум обращений в месяц — так расходы не выйдут из-под контроля

# 5. Необязательно: свой предмет и профиль (создаются мастером tutor-builder)
PACK=
PROFILE_PATH=profile.json
